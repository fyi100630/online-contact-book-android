<?xml version="1.0" encoding="utf-8"?>
<!-- 登入狀態（加密的 cookie）不備份到雲端、也不搬到新手機 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
